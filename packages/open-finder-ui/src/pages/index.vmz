<template>
    <div data-open-finder="root" class="of-root">
        <header class="of-bar">
            <div class="of-search">
                <span class="of-search__mark" aria-hidden="true">/</span>
                <label class="of-sr" for="of-query">Search</label>
                <input
                    id="of-query"
                    class="of-search__input"
                    type="text"
                    spellcheck="false"
                    autocomplete="off"
                    :value="pattern"
                    :placeholder="searchPlaceholder"
                    @input="onQueryInput"
                    @keydown="onQueryKey"
                />
                <button
                    v-if="pattern"
                    type="button"
                    class="of-search__clear"
                    aria-label="Clear search"
                    @click="clearQuery"
                >
                    ×
                </button>
            </div>
            <div class="of-mode" role="group" aria-label="Search mode">
                <button
                    type="button"
                    class="of-mode__item"
                    :data-active="mode === 'index' ? 'true' : 'false'"
                    data-mode="index"
                    title="Search the persisted index (I)"
                    @click="setMode"
                >
                    Index
                </button>
                <button
                    type="button"
                    class="of-mode__item"
                    :data-active="mode === 'walk' ? 'true' : 'false'"
                    data-mode="walk"
                    title="Walk a folder without an index (W)"
                    @click="setMode"
                >
                    Walk
                </button>
            </div>
            <button
                type="button"
                class="of-btn"
                :data-active="advancedOpen ? 'true' : 'false'"
                :aria-expanded="advancedOpen ? 'true' : 'false'"
                title="Advanced conditions (Ctrl+Shift+F)"
                @click="toggleAdvanced"
            >
                Filters<span v-if="activeFilterCount" class="of-btn__count">{{ activeFilterCount }}</span>
            </button>
            <button type="button" class="of-btn of-btn--primary" :disabled="loading" @click="runSearch">
                {{ loading ? "Searching…" : "Search" }}
            </button>
        </header>

        <section v-if="advancedOpen" class="of-advanced" aria-label="Advanced conditions">
            <div class="of-field">
                <label for="of-root">Folder to walk</label>
                <input id="of-root" type="text" spellcheck="false" :value="rootPath" placeholder="C:\\" @input="onRootInput" />
            </div>
            <div class="of-field">
                <label for="of-kind">Kind</label>
                <select id="of-kind" :value="kind" @change="onKindChange">
                    <option value="any">Any</option>
                    <option value="file">File</option>
                    <option value="dir">Folder</option>
                </select>
            </div>
            <div class="of-field">
                <label for="of-min">Min size (MB)</label>
                <input id="of-min" type="number" min="0" step="0.1" :value="minSizeMb" @input="onMinSizeInput" />
            </div>
            <div class="of-field">
                <label for="of-max">Max size (MB)</label>
                <input id="of-max" type="number" min="0" step="0.1" :value="maxSizeMb" @input="onMaxSizeInput" />
            </div>
            <div class="of-field">
                <label for="of-after">Modified after</label>
                <input id="of-after" type="datetime-local" :value="modifiedAfter" @input="onAfterInput" />
            </div>
            <div class="of-field">
                <label for="of-before">Modified before</label>
                <input id="of-before" type="datetime-local" :value="modifiedBefore" @input="onBeforeInput" />
            </div>
            <div class="of-field">
                <label for="of-sort">Sort</label>
                <select id="of-sort" :value="sort" @change="onSortChange">
                    <option value="name">Name</option>
                    <option value="path">Path</option>
                    <option value="size">Size</option>
                    <option value="modified">Modified</option>
                </select>
            </div>
            <div class="of-field of-field--checks">
                <label><input type="checkbox" :checked="regex" @change="onRegexChange" /> Regular expression</label>
                <label><input type="checkbox" :checked="matchPath" @change="onMatchPathChange" /> Match full path</label>
                <label><input type="checkbox" :checked="descending" @change="onDescendingChange" /> Descending</label>
                <span class="of-field__spacer"></span>
                <button type="button" class="of-btn" @click="resetFilters">Reset</button>
                <button type="button" class="of-btn of-btn--primary" :disabled="loading" @click="runSearch">Apply</button>
            </div>
        </section>

        <div v-if="activeFilters.length" class="of-chips" aria-label="Active conditions">
            <button
                v-for="chip in activeFilters"
                :key="chip.id"
                type="button"
                class="of-chip"
                :data-chip="chip.id"
                :title="'Remove ' + chip.label"
                @click="removeFilter"
            >
                {{ chip.label }}<span class="of-chip__x" aria-hidden="true">×</span>
            </button>
        </div>

        <div v-if="error" class="of-banner" role="alert">
            <span class="of-banner__text">{{ error }}</span>
            <button type="button" class="of-btn" @click="runSearch">Retry</button>
        </div>

        <main class="of-results" aria-label="Search results">
            <table class="of-table">
                <colgroup>
                    <col class="of-col-name" />
                    <col class="of-col-path" />
                    <col class="of-col-size" />
                    <col class="of-col-time" />
                    <col class="of-col-kind" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Path</th>
                        <th scope="col" class="of-num">Size</th>
                        <th scope="col">Modified</th>
                        <th scope="col">Type</th>
                    </tr>
                </thead>
                <tbody
                    tabindex="0"
                    aria-label="Results"
                    @keydown="onTableKey"
                    @contextmenu.prevent="openRowMenu"
                >
                    <tr
                        v-for="row in rows"
                        :key="row.key"
                        :data-index="row.index"
                        :data-focused="row.index === focusedIndex ? 'true' : 'false'"
                        @click="focusRow"
                    >
                        <td class="of-name" :title="row.name">{{ row.name }}</td>
                        <td class="of-path" :title="row.path">{{ row.dirLabel }}</td>
                        <td class="of-num">{{ row.sizeText }}</td>
                        <td>{{ row.modifiedText }}</td>
                        <td class="of-kind">{{ row.typeText }}</td>
                    </tr>
                </tbody>
            </table>
            <div v-if="!rows.length && !loading && !error" class="of-empty">
                <div class="of-empty__title">{{ emptyTitle }}</div>
                <p class="of-empty__desc">{{ emptyDesc }}</p>
            </div>
            <div v-if="loading && !rows.length" class="of-loading" role="status">
                <span class="of-spinner" aria-hidden="true"></span>{{ loadingText }}
            </div>
        </main>

        <footer class="of-status" role="status">
            <span class="of-status__state">{{ statusMessage }}</span>
            <span class="of-status__grow"></span>
            <span>{{ countText }}</span>
            <span>{{ timingText }}</span>
            <span>{{ modeText }}</span>
            <span :class="truncated ? 'of-status__warn' : ''">{{ indexText }}</span>
            <button type="button" class="of-status__host" @click="toggleCapabilities">Host</button>
        </footer>

        <div v-if="menuOpen" class="of-menu" :style="menuStyle" role="menu">
            <button type="button" class="of-menu__item" role="menuitem" aria-disabled="true" :title="openReason" disabled>
                Open
            </button>
            <button type="button" class="of-menu__item" role="menuitem" aria-disabled="true" :title="openReason" disabled>
                Reveal in Explorer
            </button>
            <button type="button" class="of-menu__item" role="menuitem" @click="copyFocusedPath">
                Copy path
            </button>
            <button type="button" class="of-menu__item" role="menuitem" @click="copyFocusedName">
                Copy name
            </button>
            <div class="of-menu__note">{{ openReason }}</div>
        </div>

        <section v-if="capabilitiesOpen" class="of-caps" aria-label="Host capabilities">
            <header class="of-caps__head">
                <span>Host capabilities</span>
                <button type="button" class="of-btn" aria-label="Close capabilities" @click="toggleCapabilities">×</button>
            </header>
            <ul class="of-caps__list">
                <li v-for="row in capabilityRows" :key="row.id">
                    <span>{{ row.title }}</span>
                    <span>{{ row.state }}</span>
                    <span class="of-caps__detail">{{ row.detail }}</span>
                </li>
            </ul>
        </section>
    </div>
</template>

<style>
html,
body {
    height: 100%;
    margin: 0;
    overflow: hidden;
}

.of-root {
    --of-bar-height: 2.5rem;
    --of-status-height: 1.5rem;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100vh;
    min-height: 0;
    overflow: hidden;
    background: var(--vmz-surface-paper, #ffffff);
    color: var(--vmz-text-ink, #1b1830);
    font-family: var(--vmz-font-sans, system-ui, sans-serif);
    font-size: 0.8125rem;
}

.of-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
}

.of-bar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.375rem;
    min-height: var(--of-bar-height);
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e4e0f0);
    background: var(--vmz-surface-mist, #f8f7fc);
}

.of-search {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    min-width: 10rem;
    height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper, #ffffff);
}

.of-search:focus-within {
    border-color: var(--vmz-action-primary-background, #6e56cf);
    box-shadow: 0 0 0 2px var(--vmz-focus-ring, rgba(110, 86, 207, 0.18));
}

.of-search__mark {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    margin-right: 0.375rem;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: 3px;
    color: var(--vmz-text-tertiary, #6b6785);
    font-size: 0.6875rem;
}

.of-search__input {
    flex: 1 1 auto;
    min-width: 4rem;
    height: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    outline: none;
}

.of-search__clear {
    flex: 0 0 auto;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--vmz-text-tertiary, #6b6785);
    font: inherit;
    cursor: pointer;
}

.of-search__clear:hover {
    background: var(--vmz-action-secondary-hover, #f2f0f9);
}

.of-mode {
    display: inline-flex;
    flex: 0 0 auto;
    height: 2rem;
    padding: 2px;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper, #ffffff);
}

.of-mode__item {
    padding: 0 0.5rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--vmz-text-tertiary, #6b6785);
    font: inherit;
    cursor: pointer;
}

.of-mode__item[data-active="true"] {
    background: var(--vmz-action-primary-background, #6e56cf);
    color: #ffffff;
}

.of-btn {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.25rem;
    height: 2rem;
    padding: 0 0.625rem;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper, #ffffff);
    color: inherit;
    font: inherit;
    cursor: pointer;
}

.of-btn:hover:not(:disabled) {
    background: var(--vmz-action-secondary-hover, #f2f0f9);
}

.of-btn:disabled {
    color: var(--vmz-text-muted, #b3aec6);
    cursor: default;
}

.of-btn[data-active="true"] {
    border-color: var(--vmz-action-primary-background, #6e56cf);
    background: var(--vmz-action-secondary-hover, #f2f0f9);
}

.of-btn--primary {
    border-color: var(--vmz-action-primary-background, #6e56cf);
    background: var(--vmz-action-primary-background, #6e56cf);
    color: var(--vmz-action-primary-foreground, #ffffff);
}

.of-btn--primary:hover:not(:disabled) {
    background: var(--vmz-action-primary-hover, #5a45b5);
}

.of-btn__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0 0.1875rem;
    border-radius: 0.5625rem;
    background: var(--vmz-action-primary-background, #6e56cf);
    color: #ffffff;
    font-size: 0.6875rem;
}

.of-advanced {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.5rem 0.75rem;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--vmz-line-default, #e4e0f0);
    background: var(--vmz-surface-page, #fbfaff);
}

.of-field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.25rem;
}

.of-field > label {
    color: var(--vmz-text-tertiary, #6b6785);
    font-size: 0.6875rem;
}

.of-field input,
.of-field select {
    width: 100%;
    min-width: 0;
    height: 1.75rem;
    padding: 0 0.375rem;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: var(--vmz-radius-sm, 4px);
    background: var(--vmz-surface-paper, #ffffff);
    color: inherit;
    font: inherit;
    font-size: 0.75rem;
}

.of-field--checks {
    grid-column: 1 / -1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.25rem;
    padding-top: 0.25rem;
}

.of-field--checks label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--vmz-text-ink, #1b1830);
