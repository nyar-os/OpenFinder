}

.of-field__spacer {
    flex: 1 1 auto;
    min-width: 0;
}

.of-chips {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid var(--vmz-line-subtle, #f0edf8);
    background: var(--vmz-surface-paper, #ffffff);
}

.of-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 1.375rem;
    padding: 0 0.375rem;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: 0.6875rem;
    background: var(--vmz-surface-mist, #f8f7fc);
    color: var(--vmz-text-ink, #1b1830);
    font: inherit;
    font-size: 0.71875rem;
    cursor: pointer;
}

.of-chip:hover {
    border-color: var(--vmz-action-primary-background, #6e56cf);
}

.of-chip__x {
    color: var(--vmz-text-tertiary, #6b6785);
}

.of-banner {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid var(--vmz-status-danger-border, #f0c4c1);
    background: var(--vmz-status-danger-background, #fff3f2);
    color: var(--vmz-status-danger-foreground, #b42318);
    font-size: 0.75rem;
}

.of-banner__text {
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.of-results {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    background: var(--vmz-surface-paper, #ffffff);
}

.of-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.75rem;
}

.of-col-name {
    width: 30%;
}

.of-col-size {
    width: 5.5rem;
}

.of-col-time {
    width: 8.5rem;
}

.of-col-kind {
    width: 4.5rem;
}

.of-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 1.625rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e4e0f0);
    background: var(--vmz-surface-mist, #f8f7fc);
    color: var(--vmz-text-tertiary, #6b6785);
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
}

.of-table tbody {
    outline: none;
}

.of-table tbody tr {
    height: 1.625rem;
    cursor: default;
}

.of-table tbody tr:hover {
    background: var(--vmz-action-secondary-hover, #f2f0f9);
}

.of-table tbody tr[data-focused="true"] {
    background: var(--vmz-action-primary-background, #6e56cf);
    color: #ffffff;
}

.of-table tbody tr[data-focused="true"] .of-path,
.of-table tbody tr[data-focused="true"] .of-kind {
    color: #ffffff;
}

.of-table td {
    padding: 0 0.5rem;
    border-bottom: 1px solid var(--vmz-line-subtle, #f0edf8);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.of-table th.of-num,
.of-table td.of-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
}

.of-name {
    font-weight: 500;
}

.of-path,
.of-kind {
    color: var(--vmz-text-tertiary, #6b6785);
}

.of-kind {
    font-size: 0.6875rem;
    text-transform: uppercase;
}

.of-empty,
.of-loading {
    position: absolute;
    inset: 2.25rem 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 2rem;
    color: var(--vmz-text-tertiary, #6b6785);
    text-align: center;
    pointer-events: none;
}

.of-empty__title {
    color: var(--vmz-text-ink, #1b1830);
    font-size: 0.9375rem;
    font-weight: 600;
}

.of-empty__desc {
    max-width: 30rem;
    margin: 0;
}

.of-loading {
    flex-direction: row;
    gap: 0.5rem;
}

.of-spinner {
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--vmz-line-default, #e4e0f0);
    border-top-color: var(--vmz-action-primary-background, #6e56cf);
    border-radius: 50%;
    animation: of-spin 0.8s linear infinite;
}

@keyframes of-spin {
    to {
        transform: rotate(360deg);
    }
}

.of-status {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
    height: var(--of-status-height);
    padding: 0 0.5rem;
    border-top: 1px solid var(--vmz-line-default, #e4e0f0);
    background: var(--vmz-surface-mist, #f8f7fc);
    color: var(--vmz-text-tertiary, #6b6785);
    font-size: 0.71875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
}

.of-status__state {
    max-width: 34%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--vmz-text-ink, #1b1830);
}

.of-status__grow {
    flex: 1 1 auto;
}

.of-status__warn {
    color: var(--vmz-status-warning-foreground, #8a5a00);
}

.of-status__host {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
}

.of-menu {
    position: fixed;
    z-index: 12;
    display: flex;
    flex-direction: column;
    width: 13rem;
    padding: 0.25rem;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper, #ffffff);
    box-shadow: 0 8px 24px rgba(27, 24, 48, 0.18);
}

.of-menu__item {
    height: 1.75rem;
    padding: 0 0.5rem;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
}

.of-menu__item:hover:not(:disabled) {
    background: var(--vmz-action-secondary-hover, #f2f0f9);
}

.of-menu__item:disabled {
    color: var(--vmz-text-muted, #b3aec6);
    cursor: default;
}

.of-menu__note {
    margin-top: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-top: 1px solid var(--vmz-line-subtle, #f0edf8);
    color: var(--vmz-text-tertiary, #6b6785);
    font-size: 0.6875rem;
    line-height: 1.35;
    white-space: normal;
}

.of-caps {
    position: absolute;
    right: 0.5rem;
    bottom: calc(var(--of-status-height) + 0.5rem);
    z-index: 10;
    display: flex;
    flex-direction: column;
    width: min(22rem, calc(100% - 1rem));
    max-height: 60vh;
    border: 1px solid var(--vmz-line-default, #e4e0f0);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper, #ffffff);
    box-shadow: 0 10px 30px rgba(27, 24, 48, 0.18);
    overflow: auto;
}

.of-caps__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid var(--vmz-line-default, #e4e0f0);
    background: var(--vmz-surface-mist, #f8f7fc);
    font-size: 0.75rem;
    font-weight: 600;
}

.of-caps__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
}

.of-caps__list li {
    display: grid;
    grid-template-columns: minmax(6rem, 1fr) auto;
    gap: 0.125rem 0.5rem;
    font-size: 0.71875rem;
}

.of-caps__detail {
    grid-column: 1 / -1;
    color: var(--vmz-text-tertiary, #6b6785);
    overflow-wrap: anywhere;
}

@media (max-width: 900px) {
    .of-col-size,
    .of-col-kind,
    .of-table th:nth-child(3),
    .of-table td:nth-child(3),
    .of-table th:nth-child(5),
    .of-table td:nth-child(5) {
        display: none;
    }

    .of-col-name {
        width: 34%;
    }

    .of-col-time {
        width: 7.5rem;
    }

    .of-mode__item {
        padding: 0 0.375rem;
    }

    .of-btn {
        padding: 0 0.375rem;
    }
}

@media (max-width: 620px) {
    .of-col-time,
    .of-table th:nth-child(4),
    .of-table td:nth-child(4) {
        display: none;
    }

    .of-mode {
        display: none;
    }

    .of-status__state {
        max-width: 52%;
    }
}
</style>

<script client>
/**
 * Finder page.
 *
 * All search, walk, and capability work runs in the Rust crates. The page keeps
 * only the query draft, the rendered page, and keyboard focus; it never fabricates
 * hits or index state.
 */
export default class FinderPage {
    searchPlaceholder = "Search names or patterns ( / )";
    emptyTitle = "No results yet";
    emptyDesc = "Type a name or glob and press Enter. Switch to Walk to scan a folder without an index.";
    openReason = "This host exposes no shell open or reveal handler yet, so those actions stay disabled.";

    pattern = "";
    rootPath = "";
    mode = "index";
    kind = "any";
    minSizeMb = "";
    maxSizeMb = "";
    modifiedAfter = "";
    modifiedBefore = "";
    regex = false;
    matchPath = false;
    sort = "name";
    descending = false;
    advancedOpen = false;
    activeFilters = [];
    activeFilterCount = 0;
    rows = [];
    total = 0;
    tookMs = 0;
    indexed = false;
    skipped = 0;
    truncated = false;
    offset = 0;
    limit = 200;
    loading = false;
    error = "";
    status = "";
    statusMessage = "Ready";
    focusedIndex = -1;
    menuOpen = false;
    menuStyle = "";
    menuRowIndex = -1;
    capabilitiesOpen = false;
    capabilityRows = [];
    loadingCapabilities = false;
    countText = "0 results";
    timingText = "";
    modeText = "Index";
    indexText = "";
    loadingText = "Searching the index…";
    _seq = 0;
    _timer = 0;
    _query = "";

    onMount() {
        this.installHostBridge();
        this.installKeyboard();
        document.addEventListener("pointerdown", (event) => {
            if (this.menuOpen && event.target && !event.target.closest(".of-menu")) this.closeMenu();
        });
        setTimeout(() => {
            const input = document.getElementById("of-query");
            if (input) input.focus();
        }, 0);
    }

    bridge() {
        const webview = globalThis.chrome && globalThis.chrome.webview;
        return webview && webview.postMessage ? webview : null;
    }

    installHostBridge() {
        const webview = this.bridge();
        if (!webview || !webview.addEventListener) return;
        webview.addEventListener("message", (event) => {
            let data = event.data;
            if (typeof data === "string") {
                try {
                    data = JSON.parse(data);
                }
                catch {
                    return;
                }
            }
            if (!data || typeof data !== "object") return;
            if (data.ok === true) {
                this.applyResponse(data.data || {});
            }
            else if (data.ok === false) {
                this.loading = false;
                this.error = this.describeError(data.error);
                this.refreshStatus();
            }
        });
    }

    installKeyboard() {
        document.addEventListener("keydown", (event) => {
            const target = event.target;
            const typing = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT");
            if (event.key === "Escape" && this.menuOpen) {
                this.closeMenu();
                return;
            }
            if (typing) return;
            if (event.key === "/" || (event.ctrlKey && (event.key === "l" || event.key === "L"))) {
                event.preventDefault();
                const input = document.getElementById("of-query");
                if (input) {
                    input.focus();
                    input.select();
                }
            }
            else if (event.ctrlKey && event.shiftKey && (event.key === "f" || event.key === "F")) {
                event.preventDefault();
                this.toggleAdvanced();
            }
            else if (event.key === "ArrowDown" && this.rows.length && this.focusedIndex < 0) {
                event.preventDefault();
                this.focusAt(0);
            }
        });
    }

    describeError(error) {
        if (typeof error === "string") return error;
        if (error && typeof error === "object") {
            const code = error.code ? `[${error.code}] ` : "";
            return `${code}${error.message || "request failed"}`;
        }
        return "request failed";
    }

    onQueryInput(e) {
        this.pattern = e && e.target ? String(e.target.value || "") : "";
        this.scheduleSearch();
    }

    onRootInput(e) {
        this.rootPath = e && e.target ? String(e.target.value || "") : "";
    }

    onKindChange(e) {
        this.kind = e && e.target ? String(e.target.value || "any") : "any";
        this.scheduleSearch();
    }

    onMinSizeInput(e) {
        this.minSizeMb = e && e.target ? String(e.target.value || "") : "";
    }

    onMaxSizeInput(e) {
        this.maxSizeMb = e && e.target ? String(e.target.value || "") : "";
    }

    onAfterInput(e) {
        this.modifiedAfter = e && e.target ? String(e.target.value || "") : "";
    }

    onBeforeInput(e) {
        this.modifiedBefore = e && e.target ? String(e.target.value || "") : "";
    }

    onSortChange(e) {
        this.sort = e && e.target ? String(e.target.value || "name") : "name";
        this.scheduleSearch();
    }

    onRegexChange(e) {
        this.regex = !!(e && e.target && e.target.checked);
    }

    onMatchPathChange(e) {
        this.matchPath = !!(e && e.target && e.target.checked);
    }

    onDescendingChange(e) {
        this.descending = !!(e && e.target && e.target.checked);
    }

    onQueryKey(e) {
        if (!e) return;
        if (e.key === "Enter") {
            e.preventDefault();
            this.runSearch();
        }
        else if (e.key === "ArrowDown") {
            e.preventDefault();
            this.focusAt(0);
        }
    }

    setMode(e) {
        const mode = e && e.currentTarget && e.currentTarget.dataset ? e.currentTarget.dataset.mode : "index";
        this.mode = mode === "walk" ? "walk" : "index";
        this.refreshStatus();
        if (this.mode === "walk") {
            this.advancedOpen = true;
            setTimeout(() => {
                const root = document.getElementById("of-root");
                if (root && !this.rootPath) root.focus();
            }, 0);
        }
        else {
            this.scheduleSearch();
        }
    }

    toggleAdvanced() {
        this.advancedOpen = !this.advancedOpen;
        this.refreshStatus();
    }

    clearQuery() {
        this.pattern = "";
        this.closeMenu();
        const input = document.getElementById("of-query");
        if (input) input.focus();
        this.scheduleSearch();
    }

    scheduleSearch() {
        if (this._timer) clearTimeout(this._timer);
        const hasCondition = this.pattern.trim().length > 0
            || this.kind !== "any"
            || this.minSizeMb !== ""
            || this.maxSizeMb !== ""
            || this.modifiedAfter !== ""
            || this.modifiedBefore !== "";
        if (!hasCondition) {
            this.rows = [];
            this.total = 0;
            this.tookMs = 0;
            this.indexed = false;
            this.skipped = 0;
            this.truncated = false;
            this.error = "";
            this.status = "Ready";
            this.refreshStatus();
            return;
        }
        if (this.mode === "walk" && !this.rootPath.trim()) return;
        this._timer = setTimeout(() => {
            this.runSearch();
        }, 250);
    }

    buildSpec() {
        const spec = {
            pattern: this.pattern.trim() || null,
            regex: this.regex,
            matchPath: this.matchPath,
            kind: this.kind === "any" ? null : this.kind,
            sort: this.sort,
            descending: this.descending,
            limit: this.limit,
            offset: 0,
        };
        if (this.minSizeMb !== "") spec.minSize = Math.max(0, Math.round(Number(this.minSizeMb) * 1024 * 1024));
        if (this.maxSizeMb !== "") spec.maxSize = Math.max(0, Math.round(Number(this.maxSizeMb) * 1024 * 1024));
        if (this.modifiedAfter !== "") spec.modifiedAfterMs = new Date(this.modifiedAfter).getTime();
        if (this.modifiedBefore !== "") spec.modifiedBeforeMs = new Date(this.modifiedBefore).getTime();
        return spec;
    }

    runSearch() {
        if (this._timer) clearTimeout(this._timer);
        if (this.mode === "walk" && !this.rootPath.trim()) {
            this.error = "Walk mode needs a folder to scan.";
            this.refreshStatus();
            return;
        }
        this.searchAt(0, false);
    }

    searchAt(offset, append) {
        const spec = this.buildSpec();
        spec.offset = offset;
        this._seq += 1;
        this.loading = true;
        this.error = "";
        this.status = "Searching…";
        this.refreshStatus();
        const message = { type: this.mode === "walk" ? "searchWalk" : "search", requestId: this._seq, ...spec };
        if (this.mode === "walk") message.root = this.rootPath.trim();
        if (!this.post(message)) this.loading = false;
        if (append) this._append = true;
    }

    post(message) {
        const webview = this.bridge();
        if (!webview) {
            this.loading = false;
            this.error = "Native bridge unavailable (not running inside the WebView2 host).";
            this.refreshStatus();
            return false;
        }
        webview.postMessage(JSON.stringify(message));
        return true;
    }

    applyResponse(data) {
        if (Array.isArray(data.entries)) {
            this.applyCapabilities(data);
            return;
        }
        const page = data && data.hits ? data : null;
        if (!page) {
            this.loading = false;
            this.error = "Unexpected response from the host.";
            this.refreshStatus();
            return;
        }
        this.loading = false;
        this.total = Number(page.total) || 0;
        this.tookMs = Number(page.tookMs) || 0;
        this.indexed = !!page.indexed;
        this.skipped = Number(page.skipped) || 0;
        this.truncated = !!page.truncated;
        const base = this._append ? this.rows.length : 0;
        const incoming = (page.hits || []).map((hit, index) => this.describeHit(hit, base + index));
        this.rows = this._append ? this.rows.concat(incoming) : incoming;
        this.offset = base + incoming.length;
        this._append = false;
        this.error = "";
        this.status = this.rows.length ? `Scanned in ${this.tookMs} ms.` : "No matches.";
        if (this.focusedIndex >= this.rows.length) this.focusedIndex = this.rows.length - 1;
        this.refreshStatus();
    }

    describeHit(hit, index) {
        const path = String(hit.path || "");
        const name = String(hit.name || this.basename(path));
        const dir = this.dirname(path);
        const size = Number(hit.size) || 0;
        const modified = Number(hit.modifiedMs) || 0;
        return {
            index,
            key: `${index}:${path}`,
            name,
            path,
            dirLabel: dir,
            sizeText: hit.isDir ? "—" : this.formatBytes(size),
            modifiedText: this.formatTime(modified),
            typeText: hit.isDir ? "Folder" : (this.extension(name) || "File"),
        };
    }

    applyCapabilities(report) {
        this.loadingCapabilities = false;
        this.capabilityRows = (report.entries || []).map((entry) => {
            const state = entry.state || {};
            return {
                id: String(entry.id || ""),
                title: String(entry.title || entry.id || ""),
                state: `${String(state.state || "unknown")}${state.code ? ` [${state.code}]` : ""}`,
                detail: String(state.detail || ""),
            };
        });
        this.status = `Host ${report.platform || "unknown"}.`;
        this.refreshStatus();
    }

    toggleCapabilities() {
        this.capabilitiesOpen = !this.capabilitiesOpen;
        if (this.capabilitiesOpen && !this.capabilityRows.length) {
            this.loadingCapabilities = true;
            this._seq += 1;
            this.post({ type: "capabilities", requestId: this._seq });
        }
    }

    refreshStatus() {
        this.statusMessage = this.error || this.status || "Ready";
        this.countText = `${this.rows.length} of ${this.total}`;
        this.timingText = this.tookMs ? `${this.tookMs} ms` : "";
        this.modeText = this.mode === "walk" ? "Walk" : "Index";
        this.loadingText = this.mode === "walk" ? "Walking the folder…" : "Searching the index…";
        this.indexText = this.indexed
            ? "indexed"
            : (this.mode === "walk" ? `walk · skipped ${this.skipped}` : "index not used");
        this.activeFilters = this.computeFilters();
        this.activeFilterCount = this.activeFilters.length;
    }

    computeFilters() {
        const filters = [];
        if (this.kind !== "any") filters.push({ id: "kind", label: `Kind: ${this.kind === "dir" ? "folder" : "file"}` });
        if (this.minSizeMb !== "") filters.push({ id: "min", label: `Min: ${this.minSizeMb} MB` });
        if (this.maxSizeMb !== "") filters.push({ id: "max", label: `Max: ${this.maxSizeMb} MB` });
        if (this.modifiedAfter !== "") filters.push({ id: "after", label: `After: ${this.modifiedAfter}` });
        if (this.modifiedBefore !== "") filters.push({ id: "before", label: `Before: ${this.modifiedBefore}` });
        if (this.regex) filters.push({ id: "regex", label: "Regex" });
        if (this.matchPath) filters.push({ id: "matchPath", label: "Full path" });
        return filters;
    }

    removeFilter(e) {
        const id = e && e.currentTarget && e.currentTarget.dataset ? e.currentTarget.dataset.chip : "";
        if (id === "kind") this.kind = "any";
        else if (id === "min") this.minSizeMb = "";
        else if (id === "max") this.maxSizeMb = "";
        else if (id === "after") this.modifiedAfter = "";
        else if (id === "before") this.modifiedBefore = "";
        else if (id === "regex") this.regex = false;
        else if (id === "matchPath") this.matchPath = false;
        this.scheduleSearch();
    }

    resetFilters() {
        this.pattern = "";
        this.rootPath = "";
        this.kind = "any";
        this.minSizeMb = "";
        this.maxSizeMb = "";
        this.modifiedAfter = "";
        this.modifiedBefore = "";
        this.regex = false;
        this.matchPath = false;
        this.sort = "name";
        this.descending = false;
        this.rows = [];
        this.total = 0;
        this.tookMs = 0;
        this.error = "";
        this.status = "Ready";
        this.refreshStatus();
    }

    focusRow(e) {
        const index = e && e.currentTarget && e.currentTarget.dataset ? Number(e.currentTarget.dataset.index) : -1;
        if (index >= 0) this.focusAt(index);
    }

    focusAt(index) {
        if (index < 0 || index >= this.rows.length) return;
        this.focusedIndex = index;
        const row = document.querySelector(`.of-table tbody tr[data-index="${index}"]`);
        if (row) {
            row.scrollIntoView({ block: "nearest" });
            const body = row.parentElement;
            if (body) body.focus({ preventScroll: true });
        }
    }

    onTableKey(e) {
        if (!e) return;
        if (e.key === "ArrowDown") {
            e.preventDefault();
            this.focusAt(Math.min(this.rows.length - 1, this.focusedIndex + 1));
        }
        else if (e.key === "ArrowUp") {
            e.preventDefault();
            this.focusAt(Math.max(0, this.focusedIndex - 1));
        }
        else if (e.key === "PageDown") {
            e.preventDefault();
            this.focusAt(Math.min(this.rows.length - 1, this.focusedIndex + 12));
        }
        else if (e.key === "PageUp") {
            e.preventDefault();
            this.focusAt(Math.max(0, this.focusedIndex - 12));
        }
        else if (e.key === "Home") {
            e.preventDefault();
            this.focusAt(0);
        }
        else if (e.key === "End") {
            e.preventDefault();
            this.focusAt(this.rows.length - 1);
        }
        else if (e.key === "Enter") {
            e.preventDefault();
            this.openMenuForFocused(e);
        }
        else if (e.ctrlKey && (e.key === "c" || e.key === "C")) {
            e.preventDefault();
            this.copyFocusedPath();
        }
        else if (e.key === "Escape") {
            this.closeMenu();
        }
    }

    openRowMenu(e) {
        const row = e && e.target ? e.target.closest("tr[data-index]") : null;
        if (!row) return;
        const index = Number(row.dataset.index);
        this.focusAt(index);
        this.menuRowIndex = index;
        this.menuOpen = true;
        const width = 208;
        const x = Math.max(4, Math.min((e.clientX || 0), globalThis.innerWidth - width - 4));
        const y = Math.max(4, Math.min((e.clientY || 0), globalThis.innerHeight - 180));
        this.menuStyle = `left:${x}px;top:${y}px`;
    }

    openMenuForFocused(e) {
        if (this.focusedIndex < 0) return;
        const row = document.querySelector(`.of-table tbody tr[data-index="${this.focusedIndex}"]`);
        this.menuRowIndex = this.focusedIndex;
        if (row) {
            const rect = row.getBoundingClientRect();
            this.menuOpen = true;
            this.menuStyle = `left:${Math.max(4, rect.left + 24)}px;top:${Math.min(globalThis.innerHeight - 180, rect.bottom + 2)}px`;
        }
        else {
            this.menuOpen = true;
            this.menuStyle = "left:0.5rem;top:6rem";
        }
    }

    closeMenu() {
        this.menuOpen = false;
        this.menuRowIndex = -1;
    }

    focusedRow() {
        return this.rows[this.menuRowIndex >= 0 ? this.menuRowIndex : this.focusedIndex] || null;
    }

    async copyFocusedPath() {
        const row = this.focusedRow();
        if (!row) return;
        await this.copyText(row.path, "Path copied.");
    }

    async copyFocusedName() {
        const row = this.focusedRow();
        if (!row) return;
        await this.copyText(row.name, "Name copied.");
    }

    async copyText(text, message) {
        try {
            await navigator.clipboard.writeText(text);
            this.status = message;
            this.closeMenu();
            this.refreshStatus();
        }
        catch {
            this.error = "Clipboard access was refused by the host.";
            this.closeMenu();
            this.refreshStatus();
        }
    }

    basename(path) {
        const value = String(path || "");
        const index = Math.max(value.lastIndexOf("\\"), value.lastIndexOf("/"));
        return index >= 0 ? value.slice(index + 1) : value;
    }

    dirname(path) {
        const value = String(path || "");
        const index = Math.max(value.lastIndexOf("\\"), value.lastIndexOf("/"));
        return index >= 0 ? value.slice(0, index) : value;
    }

    extension(name) {
        const value = String(name || "");
        const index = value.lastIndexOf(".");
        return index > 0 ? value.slice(index + 1).toUpperCase() : "";
    }

    formatBytes(size) {
        if (!size) return "0 B";
        if (size < 1024) return `${size} B`;
        if (size < 1024 ** 2) return `${(size / 1024).toFixed(1)} KB`;
        if (size < 1024 ** 3) return `${(size / 1024 ** 2).toFixed(1)} MB`;
        return `${(size / 1024 ** 3).toFixed(2)} GB`;
    }

    formatTime(ms) {
        if (!ms) return "—";
        const date = new Date(ms);
        const pad = (n) => String(n).padStart(2, "0");
        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }
}
</script>
