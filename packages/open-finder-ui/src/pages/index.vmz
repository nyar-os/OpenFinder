<template>
    <div class="app-root" data-app="open-finder">
        <AppShell brand="OpenFinder" homeHref="/" navLabel="Navigation" activeId="home" :nav="navItems">
            <div class="vmz-slot-content app-body">
                <header class="app-head">
                    <h1>
                        {{ title }}
                    </h1>
                    <p>
                        {{ lead }}
                    </p>
                </header>

                <Card :title="searchTitle" :description="searchDesc">
                    <div class="app-grid">
                        <Field
                            :label="patternLabel"
                            :description="patternDesc"
                            controlId="search-pattern"
                            descriptionId="search-pattern-desc"
                            errorId="search-pattern-err"
                            describedBy="search-pattern-desc"
                            :value="pattern"
                            :placeholder="patternPlaceholder"
                            @input="onPatternInput"
                        />
                        <Field
                            :label="pathFilterLabel"
                            :description="pathFilterDesc"
                            controlId="search-path"
                            descriptionId="search-path-desc"
                            errorId="search-path-err"
                            describedBy="search-path-desc"
                            :value="pathFilter"
                            :placeholder="pathFilterPlaceholder"
                            @input="onPathFilterInput"
                        />
                    </div>
                    <div class="app-grid">
                        <label class="app-select">
                            <span>{{ kindLabel }}</span>
                            <select :value="kind" @change="onKindChange">
                                <option value="">
                                    {{ kindAny }}
                                </option>
                                <option value="file">
                                    {{ kindFile }}
                                </option>
                                <option value="dir">
                                    {{ kindDir }}
                                </option>
                            </select>
                        </label>
                        <label class="app-select">
                            <span>{{ sortLabel }}</span>
                            <select :value="sort" @change="onSortChange">
                                <option value="name">
                                    {{ sortName }}
                                </option>
                                <option value="path">
                                    {{ sortPath }}
                                </option>
                                <option value="size">
                                    {{ sortSize }}
                                </option>
                                <option value="modified">
                                    {{ sortModified }}
                                </option>
                            </select>
                        </label>
                    </div>
                    <div class="app-actions">
                        <Button type="button" :loading="searching" :disabled="searching" @click="resetAndSearch">
                            {{ searchLabel }}
                        </Button>
                        <Button type="button" variant="secondary" :loading="searching" :disabled="searching || offset === 0" @click="previousPage">
                            {{ previousLabel }}
                        </Button>
                        <Button type="button" variant="secondary" :loading="searching" :disabled="searching || !hasMore" @click="nextPage">
                            {{ nextLabel }}
                        </Button>
                        <Button type="button" variant="secondary" :loading="searching" :disabled="searching" @click="runWalk">
                            {{ walkLabel }}
                        </Button>
                        <Button type="button" variant="secondary" @click="closeWindow">
                            {{ closeLabel }}
                        </Button>
                    </div>
                    <Alert v-if="error" tone="danger" roleName="alert" :title="errorTitle" :description="error" />
                    <Alert v-else-if="status" tone="info" roleName="status" :title="statusTitle" :description="status" />
                    <div class="app-stats">
                        <div class="app-stat">
                            <div class="app-stat__label">
                                {{ modeLabel }}
                            </div>
                            <div class="app-stat__value">
                                {{ modeText }}
                            </div>
                        </div>
                        <div class="app-stat">
                            <div class="app-stat__label">
                                {{ totalLabel }}
                            </div>
                            <div class="app-stat__value">
                                {{ totalText }}
                            </div>
                        </div>
                        <div class="app-stat">
                            <div class="app-stat__label">
                                {{ pageLabel }}
                            </div>
                            <div class="app-stat__value">
                                {{ pageText }}
                            </div>
                        </div>
                    </div>
                    <Empty v-if="!hitRows.length && !searching" :title="emptyHitsTitle" :description="emptyHitsDesc" />
                    <Table v-else :columns="hitColumns" :rows="hitRows" :hasRowAction="false" />
                </Card>

                <Card :title="capabilitiesTitle" :description="capabilitiesDesc">
                    <div class="app-actions">
                        <Button type="button" :loading="loadingCapabilities" :disabled="loadingCapabilities" @click="loadCapabilities">
                            {{ capabilitiesLabel }}
                        </Button>
                    </div>
                    <Empty v-if="!capabilityRows.length && !loadingCapabilities" :title="emptyTitle" :description="emptyDesc" />
                    <Table v-else :columns="capabilityColumns" :rows="capabilityRows" :hasRowAction="false" />
                </Card>
            </div>
        </AppShell>
    </div>
</template>

<style>
.app-root {
    min-height: 100vh;
}
.app-body {
    display: flex;
    flex-direction: column;
    gap: var(--vmz-space-4, 1rem);
    width: min(var(--vmz-layout-max-width, 75rem), calc(100% - (var(--vmz-layout-gutter, 1rem) * 2)));
    margin: 0 auto;
}
.app-head h1 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
}
.app-head p {
    margin: 0;
    color: var(--vmz-text-steel, var(--vmz-text-muted, #8b93a7));
}
.app-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--vmz-space-3, 0.75rem);
    margin-bottom: var(--vmz-space-3, 0.75rem);
}
.app-select {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
}
.app-select select {
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--vmz-line-default, #e5e6eb);
    border-radius: var(--vmz-radius-md, 8px);
    background: var(--vmz-surface-paper, #fff);
    color: inherit;
}
.app-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vmz-space-2, 0.5rem);
    margin: var(--vmz-space-3, 0.75rem) 0;
}
.app-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--vmz-space-3, 0.75rem);
    margin: var(--vmz-space-4, 1rem) 0;
}
.app-stat {
    padding: var(--vmz-space-3, 0.75rem);
    border: 1px solid var(--vmz-line-default, #e5e6eb);
    border-radius: var(--vmz-radius-md, 8px);
    background: var(--vmz-surface-mist, var(--vmz-surface-paper, #f7f8fa));
}
.app-stat__label {
    color: var(--vmz-text-steel, #8b93a7);
    font-size: 0.75rem;
}
.app-stat__value {
    margin-top: 0.25rem;
    font-variant-numeric: tabular-nums;
    font-size: 1.05rem;
}
@media (max-width: 720px) {
    .app-grid,
    .app-stats {
        grid-template-columns: 1fr;
    }
}
</style>

<script client>
/**
 * Search page.
 *
 * The page only renders results. Indexing, USN updates, matching, and auditing
 * live in the Rust `core` and `napi` crates. Requests go through the WebView
 * bridge implemented by `wae::webview`.
 */
export default class IndexPage {
    title = "OpenFinder";
    lead = "NTFS index search over $MFT records and the USN journal. Every query runs through the native core.";
    navItems = [{ id: "home", title: "Search", href: "/" }];

    searchTitle = "Search";
    searchDesc = "Glob uses `*` and `?`. Filters are applied by the native index, never by the page.";
    patternLabel = "Pattern";
    patternDesc = "File name glob, or a regular expression when the core receives `regex`.";
    patternPlaceholder = "*.dll";
    pathFilterLabel = "Path filter";
    pathFilterDesc = "Case-insensitive substring matched against the full path.";
    pathFilterPlaceholder = "\\Windows\\System32";
    kindLabel = "Kind";
    kindAny = "Any";
    kindFile = "Files";
    kindDir = "Directories";
    sortLabel = "Sort";
    sortName = "Name";
    sortPath = "Path";
    sortSize = "Size";
    sortModified = "Modified";
    searchLabel = "Search index";
    walkLabel = "Walk folder";
    closeLabel = "Close";
    previousLabel = "Previous page";
    nextLabel = "Next page";

    modeLabel = "Mode";
    totalLabel = "Total matches";
    pageLabel = "Page";
    modeText = "—";
    totalText = "—";
    pageText = "—";

    errorTitle = "Request failed";
    statusTitle = "Status";
    emptyHitsTitle = "No results yet";
    emptyHitsDesc = "Enter a pattern and search, or walk a folder explicitly.";
    status = "";

    capabilitiesTitle = "Capabilities";
    capabilitiesDesc = "Availability reported by crates/core. Unsupported or unfinished capabilities fail with structured codes.";
    capabilitiesLabel = "Refresh capabilities";
    emptyTitle = "No capability report yet";
    emptyDesc = "Refresh to read the capability table.";

    pattern = "*.dll";
    pathFilter = "";
    kind = "";
    sort = "name";
    pageSize = 100;
    offset = 0;
    hasMore = false;
    searching = false;
    loadingCapabilities = false;
    error = "";
    hitColumns = [
        { id: "kind", title: "Kind" },
        { id: "size", title: "Size", align: "right" },
        { id: "modified", title: "Modified" },
        { id: "path", title: "Path" },
        { id: "frn", title: "FRN", align: "right" },
    ];
    hitRows = [];
    capabilityColumns = [
        { id: "id", title: "Capability" },
        { id: "state", title: "State" },
        { id: "detail", title: "Detail" },
    ];
    capabilityRows = [];

    onMount() {
        this.installHostBridge();
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (bridge && bridge.postMessage) this.loadCapabilities();
    }

    installHostBridge() {
        const handler = (event) => {
            let data = event && typeof event === "object" && "data" in event ? event.data : event;
            if (typeof data === "string") {
                try {
                    data = JSON.parse(data);
                } catch {
                    return;
                }
            }
            this.handleReply(data);
        };
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (bridge && bridge.addEventListener) bridge.addEventListener("message", handler);
        globalThis.__waeReceive = (text) => {
            try {
                handler(JSON.parse(text));
            } catch {
                // Ignore malformed host messages.
            }
        };
    }

    post(message) {
        const payload = JSON.stringify(message);
        const win = globalThis.chrome && globalThis.chrome.webview;
        if (win && win.postMessage) {
            win.postMessage(payload);
            return true;
        }
        const webkit = globalThis.webkit && globalThis.webkit.messageHandlers;
        if (webkit && webkit.wae) {
            webkit.wae.postMessage(payload);
            return true;
        }
        this.error = "Native bridge unavailable (open this page through the host).";
        return false;
    }

    handleReply(data) {
        if (!data || typeof data !== "object") return;
        if (data.ok !== true) {
            this.searching = false;
            this.loadingCapabilities = false;
            const failure = data.error;
            this.error = typeof failure === "string" ? failure : String((failure && failure.message) || "unknown error");
            this.status = "";
            return;
        }
        const value = data.data || {};
        if (Array.isArray(value.hits)) {
            const offset = Number(value.offset) || 0;
            const total = Number(value.total) || 0;
            this.searching = false;
            this.error = "";
            this.offset = offset;
            this.hasMore = value.hasMore === true;
            this.status = `Query complete in ${Number(value.tookMs) || 0} ms.`;
            this.modeText = `${value.mode || "index"} (indexed: ${value.indexed ? "yes" : "no"})`;
            this.totalText = String(total);
            const shown = offset + value.hits.length;
            this.pageText = `${offset}..${shown} of ${total}${value.hasMore ? " +" : ""}`;
            this.hitRows = value.hits.map((hit, index) => ({
                id: String(index),
                cells: [
                    String(hit.isDir ? "dir" : "file"),
                    this.formatBytes(Number(hit.size) || 0),
                    this.formatTime(Number(hit.modifiedMs) || 0),
                    String(hit.path || ""),
                    String(hit.frn ?? "—"),
                ],
            }));
            return;
        }
        if (Array.isArray(value.items)) {
            this.loadingCapabilities = false;
            this.error = "";
            this.status = "Capability report updated.";
            this.capabilityRows = value.items.map((item, index) => ({
                id: String(index),
                cells: [String(item.id || ""), String(item.state || "supported"), String(item.detail || "")],
            }));
        }
    }

    onPatternInput(event) {
        this.pattern = event && event.target ? String(event.target.value || "") : "";
    }

    onPathFilterInput(event) {
        this.pathFilter = event && event.target ? String(event.target.value || "") : "";
    }

    onKindChange(event) {
        this.kind = event && event.target ? String(event.target.value || "") : "";
    }

    onSortChange(event) {
        this.sort = event && event.target ? String(event.target.value || "") : "name";
    }

    query() {
        return {
            pattern: this.pattern || undefined,
            pathFilter: this.pathFilter || undefined,
            kind: this.kind || undefined,
            sort: this.sort,
            limit: this.pageSize,
            offset: this.offset,
        };
    }

    runSearch() {
        this.searching = true;
        this.error = "";
        if (!this.post({ type: "search", ...this.query() })) this.searching = false;
    }

    resetAndSearch() {
        this.offset = 0;
        this.runSearch();
    }

    nextPage() {
        if (!this.hasMore) return;
        this.offset += this.pageSize;
        this.runSearch();
    }

    previousPage() {
        if (this.offset === 0) return;
        this.offset = Math.max(0, this.offset - this.pageSize);
        this.runSearch();
    }

    runWalk() {
        this.searching = true;
        this.error = "";
        const root = (this.pathFilter || "").trim();
        if (!root) {
            this.searching = false;
            this.error = "Walk mode needs an absolute folder in the path filter field.";
            return;
        }
        if (!this.post({ type: "searchWalk", root, ...this.query() })) this.searching = false;
    }

    loadCapabilities() {
        this.loadingCapabilities = true;
        this.error = "";
        if (!this.post({ type: "capabilities" })) this.loadingCapabilities = false;
    }

    closeWindow() {
        this.post({ type: "close" });
    }

    formatBytes(value) {
        if (value < 1024) return `${value} B`;
        if (value < 1024 ** 2) return `${(value / 1024).toFixed(1)} KB`;
        if (value < 1024 ** 3) return `${(value / 1024 ** 2).toFixed(1)} MB`;
        return `${(value / 1024 ** 3).toFixed(2)} GB`;
    }

    formatTime(value) {
        if (!value) return "—";
        return new Date(value).toISOString().slice(0, 19).replace("T", " ");
    }
}
</script>
