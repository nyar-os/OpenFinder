<template>
    <div class="app-root" data-app="open-finder">
        <aside class="app-sidebar" aria-label="Workspace">
            <a href="/" class="app-sidebar__brand">
                <span class="app-sidebar__mark" aria-hidden="true">
                    OF
                </span>
                <span class="app-sidebar__name">
                    OpenFinder
                </span>
            </a>
            <nav class="app-sidebar__nav" aria-label="Navigation">
                <a href="/" class="app-sidebar__nav-item" data-active="true" aria-current="page">
                    Search
                </a>
            </nav>
            <div class="app-sidebar__section">
                <span class="app-sidebar__section-title">
                    Panels
                </span>
                <button
                    type="button"
                    class="app-sidebar__action"
                    :data-active="capabilitiesOpen ? 'true' : 'false'"
                    :aria-expanded="capabilitiesOpen ? 'true' : 'false'"
                    @click="toggleCapabilities"
                >
                    {{ capabilitiesTitle }}
                </button>
            </div>
            <div class="app-sidebar__footer">
                <button type="button" class="app-sidebar__action" @click="closeWindow">
                    {{ closeLabel }}
                </button>
            </div>
        </aside>

        <main class="app-main">
            <div role="search" class="app-toolbar">
                <div class="app-toolbar__field">
                    <Field
                        :label="patternLabel"
                        controlId="search-pattern"
                        :value="pattern"
                        :placeholder="patternPlaceholder"
                        @input="onPatternInput"
                    />
                </div>
                <div class="app-toolbar__field">
                    <Field
                        :label="pathFilterLabel"
                        controlId="search-path"
                        :value="pathFilter"
                        :placeholder="pathFilterPlaceholder"
                        @input="onPathFilterInput"
                    />
                </div>
                <label class="app-select">
                    <span class="app-select__label">
                        {{ kindLabel }}
                    </span>
                    <select :value="kind" @change="onKindChange">
                        <option value="">
                            {{ kindAny }}
                        </option>
                        <option value="file">
                            {{ kindFile }}
                        </option>
                        <option value="dir">
                            {{ kindDir }}
                        </option>
                    </select>
                </label>
                <label class="app-select">
                    <span class="app-select__label">
                        {{ sortLabel }}
                    </span>
                    <select :value="sort" @change="onSortChange">
                        <option value="name">
                            {{ sortName }}
                        </option>
                        <option value="path">
                            {{ sortPath }}
                        </option>
                        <option value="size">
                            {{ sortSize }}
                        </option>
                        <option value="modified">
                            {{ sortModified }}
                        </option>
                    </select>
                </label>
                <div class="app-toolbar__actions">
                    <Button type="button" size="small" :loading="searching" :disabled="searching" @click="resetAndSearch">
                        {{ searchLabel }}
                    </Button>
                    <Button type="button" variant="secondary" size="small" :loading="searching" :disabled="searching" @click="runWalk">
                        {{ walkLabel }}
                    </Button>
                    <Button type="button" variant="secondary" size="small" :disabled="searching || offset === 0" @click="previousPage">
                        {{ previousLabel }}
                    </Button>
                    <Button type="button" variant="secondary" size="small" :disabled="searching || !hasMore" @click="nextPage">
                        {{ nextLabel }}
                    </Button>
                </div>
            </div>

            <div class="app-statusbar">
                <span class="app-statusbar__stat">
                    <span class="app-statusbar__label">
                        {{ modeLabel }}
                    </span>
                    <span class="app-statusbar__value">
                        {{ modeText }}
                    </span>
                </span>
                <span class="app-statusbar__stat">
                    <span class="app-statusbar__label">
                        {{ totalLabel }}
                    </span>
                    <span class="app-statusbar__value">
                        {{ totalText }}
                    </span>
                </span>
                <span class="app-statusbar__stat">
                    <span class="app-statusbar__label">
                        {{ pageLabel }}
                    </span>
                    <span class="app-statusbar__value">
                        {{ pageText }}
                    </span>
                </span>
                <span v-if="status" role="status" class="app-statusbar__message">
                    {{ status }}
                </span>
                <span v-if="error" role="alert" class="app-statusbar__error">
                    {{ error }}
                </span>
            </div>

            <div class="app-results">
                <div v-if="!hitRows.length && !searching" class="app-results__empty">
                    <Empty :title="emptyHitsTitle" :description="emptyHitsDesc" />
                </div>
                <Table v-else :columns="hitColumns" :rows="hitRows" :hasRowAction="false" :loading="searching" :loadingLabel="searchingLabel" />
            </div>

            <section v-if="capabilitiesOpen" class="app-drawer">
                <header class="app-drawer__head">
                    <span class="app-drawer__title">
                        {{ capabilitiesTitle }}
                    </span>
                    <span class="app-drawer__meta">
                        {{ capabilitiesDesc }}
                    </span>
                    <Button type="button" variant="secondary" size="small" :loading="loadingCapabilities" :disabled="loadingCapabilities" @click="loadCapabilities">
                        {{ capabilitiesLabel }}
                    </Button>
                </header>
                <div class="app-drawer__body">
                    <Empty v-if="!capabilityRows.length && !loadingCapabilities" :title="emptyTitle" :description="emptyDesc" />
                    <Table v-else :columns="capabilityColumns" :rows="capabilityRows" :hasRowAction="false" :loading="loadingCapabilities" :loadingLabel="searchingLabel" />
                </div>
            </section>
        </main>
    </div>
</template>

<style>
/*
 * Desktop shell: the window is the frame, not a document page. It is a single
 * full-bleed flex row — fixed-width sidebar on the left, content column on the
 * right — with no max-width, no auto margins, no page gutter, and no body
 * margin. Every horizontal pixel belongs to either the sidebar or the content
 * column; neither row nor shell adds outer padding or gap.
 */
html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}
#app,
.app-root {
    width: 100%;
    height: 100%;
}
.app-root {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    height: 100vh;
    overflow: hidden;
    font-family: var(--vmz-font-sans, system-ui, sans-serif);
    color: var(--vmz-text-ink, #111827);
    background: var(--vmz-surface-page, #f5f6f8);
}

/* Sidebar: fixed width, always visible, never a centered card. */
.app-sidebar {
    display: flex;
    flex: 0 0 var(--of-sidebar-width, 15rem);
    flex-direction: column;
    box-sizing: border-box;
    width: var(--of-sidebar-width, 15rem);
    min-width: 0;
    min-height: 0;
    padding: 0;
    border-right: 1px solid var(--vmz-line-subtle, #f0f1f3);
    background: var(--vmz-surface-paper, #fff);
}
.app-sidebar__brand {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.625rem;
    box-sizing: border-box;
    height: 3rem;
    padding: 0 0.875rem;
    border-bottom: 1px solid var(--vmz-line-subtle, #f0f1f3);
    color: var(--vmz-text-ink, #111827);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
}
.app-sidebar__mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-action-primary-background, #2563eb);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
}
.app-sidebar__nav {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.5rem 0;
}
.app-sidebar__nav-item {
    display: flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.625rem;
    border-radius: var(--vmz-radius-md, 6px);
    color: var(--vmz-text-steel, #4b5563);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
}
.app-sidebar__nav-item[data-active="true"] {
    background: var(--vmz-surface-mist, #f7f8fa);
    color: var(--vmz-action-primary-background, #2563eb);
    font-weight: 600;
}
.app-sidebar__section {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 0.5rem 0;
}
.app-sidebar__section-title {
    padding: 0 0.625rem;
    color: var(--vmz-text-tertiary, #6b7280);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
}
.app-sidebar__action {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 2rem;
    padding: 0 0.625rem;
    border: 0;
    border-radius: var(--vmz-radius-md, 6px);
    background: transparent;
    color: var(--vmz-text-steel, #4b5563);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
}
.app-sidebar__action:hover {
    background: var(--vmz-surface-mist, #f7f8fa);
}
.app-sidebar__action[data-active="true"] {
    background: var(--vmz-surface-mist, #f7f8fa);
    color: var(--vmz-action-primary-background, #2563eb);
    font-weight: 600;
}
.app-sidebar__action:focus-visible {
    outline: 0;
    box-shadow: 0 0 0 3px var(--vmz-focus-ring, rgba(37, 99, 235, 0.35));
}
.app-sidebar__footer {
    flex: 0 0 auto;
    margin-top: auto;
    padding: 0.5rem;
    border-top: 1px solid var(--vmz-line-subtle, #f0f1f3);
}

/*
 * Content column: takes every pixel the sidebar does not, and never grows past
 * it. Rows are toolbar, status, results, optional drawer. Only the results
 * table scrolls.
 */
.app-main {
    display: grid;
    flex: 1 1 auto;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    box-sizing: border-box;
    width: auto;
    min-width: 0;
    min-height: 0;
    max-width: none;
    margin: 0;
    padding: 0;
}

/* Toolbar: one horizontal band, controls wrap only when the window is narrow. */
.app-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--vmz-space-2, 0.5rem);
    padding: var(--vmz-space-2, 0.5rem) var(--vmz-space-3, 0.75rem);
    border-bottom: 1px solid var(--vmz-line-subtle, #e5e6eb);
    background: var(--vmz-surface-paper, #fff);
}
.app-toolbar__field {
    flex: 1 1 11rem;
    min-width: 9rem;
}
.app-toolbar .vmz-ui-field {
    flex-direction: row;
    align-items: center;
    max-width: none;
    gap: var(--vmz-space-2, 0.5rem);
}
.app-toolbar .vmz-ui-field__label {
    flex: 0 0 auto;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--vmz-text-tertiary, #6b7280);
}
.app-toolbar .vmz-ui-field__control {
    min-height: 2rem;
}
.app-select {
    display: flex;
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    gap: var(--vmz-space-2, 0.5rem);
}
.app-select__label {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--vmz-text-tertiary, #6b7280);
}
.app-select select {
    box-sizing: border-box;
    min-height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid var(--vmz-line-default, #e5e6eb);
    border-radius: var(--vmz-radius-md, 6px);
    background: var(--vmz-surface-paper, #fff);
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
}
.app-toolbar__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--vmz-space-2, 0.5rem);
    margin-left: auto;
}

/* Status bar: counts, paging text, timing, and failures stay out of the way. */
.app-statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--vmz-space-4, 1rem);
    min-height: 1.75rem;
    padding: 0 var(--vmz-space-3, 0.75rem);
    border-bottom: 1px solid var(--vmz-line-subtle, #e5e6eb);
    background: var(--vmz-surface-mist, #f7f8fa);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--vmz-text-tertiary, #6b7280);
    white-space: nowrap;
    overflow: hidden;
}
.app-statusbar__stat {
    display: inline-flex;
    gap: 0.35rem;
}
.app-statusbar__value {
    color: var(--vmz-text-ink, #111827);
    font-variant-numeric: tabular-nums;
}
.app-statusbar__message {
    overflow: hidden;
    text-overflow: ellipsis;
}
.app-statusbar__error {
    color: var(--vmz-status-danger-foreground, #b42318);
    font-weight: 500;
}

/* Results: the table owns the remaining height, its header stays pinned. */
.app-results {
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--vmz-surface-paper, #fff);
}
.app-results > .vmz-ui-table-wrap {
    flex: 1 1 auto;
    height: 100%;
    min-height: 0;
    overflow: auto;
    border: 0;
    border-radius: 0;
}
.app-results__empty {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
}
.app-results .vmz-ui-table {
    width: 100%;
    min-width: 0;
    table-layout: auto;
    border-collapse: separate;
    border-spacing: 0;
}
.app-results .vmz-ui-table th,
.app-results .vmz-ui-table td {
    box-sizing: border-box;
    /* A cell height is a floor: wrapped paths make the row grow. */
    height: 2.25rem;
    padding: 0.125rem 0.75rem;
}
.app-results .vmz-ui-table th {
    position: sticky;
    top: 0;
    z-index: 2;
}
/*
 * Column widths: the four narrow columns are sized to their longest real value
 * and `path` keeps no width, so the automatic table layout spends everything
 * that is left on it. `table-layout: fixed` cannot express that: it hands
 * unclaimed width to the columns that already have one, which widened FRN and
 * Modified while the path column stayed cramped, and a `calc()` remainder made
 * Chrome shrink the whole table instead.
 */
.app-results .vmz-ui-table th[data-vmz-col="kind"] {
    width: 4.5rem;
}
.app-results .vmz-ui-table th[data-vmz-col="size"] {
    width: 6.5rem;
}
.app-results .vmz-ui-table th[data-vmz-col="modified"] {
    width: 10.5rem;
}
.app-results .vmz-ui-table th[data-vmz-col="frn"] {
    width: 9rem;
}
.app-results .vmz-ui-table th[data-vmz-col="path"] {
    width: auto;
    min-width: 10rem;
}
/* Column order: kind, size, modified, path, frn. */
.app-results .vmz-ui-table td:nth-child(4) {
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.35;
}

/* Capabilities: a bounded drawer, never a second full-height card. */
.app-drawer {
    display: flex;
    flex-direction: column;
    max-height: 32vh;
    min-height: 0;
    border-top: 1px solid var(--vmz-line-default, #e5e6eb);
    background: var(--vmz-surface-paper, #fff);
}
.app-drawer__head {
    display: flex;
    align-items: center;
    gap: var(--vmz-space-3, 0.75rem);
    padding: var(--vmz-space-2, 0.5rem) var(--vmz-space-3, 0.75rem);
    border-bottom: 1px solid var(--vmz-line-subtle, #e5e6eb);
    background: var(--vmz-surface-mist, #f7f8fa);
    font-size: 0.75rem;
}
.app-drawer__title {
    font-weight: 600;
    color: var(--vmz-text-ink, #111827);
}
.app-drawer__meta {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--vmz-text-tertiary, #6b7280);
}
.app-drawer__head .vmz-ui-btn {
    margin-left: auto;
}
.app-drawer__body {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
}

@media (max-width: 900px) {
    .app-toolbar__field {
        flex-basis: 100%;
    }
    .app-toolbar__actions {
        margin-left: 0;
        flex-wrap: wrap;
    }
}
</style>

<script client>
/**
 * Search page.
 *
 * The page only renders results. Indexing, USN updates, matching, and auditing
 * live in the Rust `core` and `napi` crates. Requests go through the WebView
 * bridge implemented by `wae::webview`.
 */
export default class IndexPage {
    patternLabel = "Pattern";
    patternPlaceholder = "*.dll";
    pathFilterLabel = "Path filter";
    pathFilterPlaceholder = "\\Windows\\System32";
    kindLabel = "Kind";
    kindAny = "Any";
    kindFile = "Files";
    kindDir = "Directories";
    sortLabel = "Sort";
    sortName = "Name";
    sortPath = "Path";
    sortSize = "Size";
    sortModified = "Modified";
    searchLabel = "Search index";
    walkLabel = "Walk folder";
    closeLabel = "Close";
    previousLabel = "Previous";
    nextLabel = "Next";
    searchingLabel = "Searching";

    modeLabel = "Mode";
    totalLabel = "Matches";
    pageLabel = "Page";
    modeText = "—";
    totalText = "—";
    pageText = "—";

    emptyHitsTitle = "No results yet";
    emptyHitsDesc = "Enter a pattern and search, or walk a folder explicitly.";
    status = "";

    capabilitiesTitle = "Capabilities";
    capabilitiesDesc = "Availability reported by crates/core. Unsupported or unfinished capabilities fail with structured codes.";
    capabilitiesLabel = "Refresh";
    capabilitiesOpen = false;
    emptyTitle = "No capability report yet";
    emptyDesc = "Refresh to read the capability table.";

    pattern = "*.dll";
    pathFilter = "";
    kind = "";
    sort = "name";
    pageSize = 100;
    offset = 0;
    hasMore = false;
    searching = false;
    loadingCapabilities = false;
    error = "";
    hitColumns = [
        { id: "kind", title: "Kind" },
        { id: "size", title: "Size", align: "right" },
        { id: "modified", title: "Modified" },
        { id: "path", title: "Path" },
        { id: "frn", title: "FRN", align: "right" },
    ];
    hitRows = [];
    capabilityColumns = [
        { id: "id", title: "Capability" },
        { id: "state", title: "State" },
        { id: "detail", title: "Detail" },
    ];
    capabilityRows = [];

    onMount() {
        this.installHostBridge();
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (bridge && bridge.postMessage) this.loadCapabilities();
    }

    installHostBridge() {
        const handler = (event) => {
            let data = event && typeof event === "object" && "data" in event ? event.data : event;
            if (typeof data === "string") {
                try {
                    data = JSON.parse(data);
                } catch {
                    return;
                }
            }
            this.handleReply(data);
        };
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (bridge && bridge.addEventListener) bridge.addEventListener("message", handler);
        globalThis.__waeReceive = (text) => {
            try {
                handler(JSON.parse(text));
            } catch {
                // Ignore malformed host messages.
            }
        };
    }

    post(message) {
        const payload = JSON.stringify(message);
        const win = globalThis.chrome && globalThis.chrome.webview;
        if (win && win.postMessage) {
            win.postMessage(payload);
            return true;
        }
        const webkit = globalThis.webkit && globalThis.webkit.messageHandlers;
        if (webkit && webkit.wae) {
            webkit.wae.postMessage(payload);
            return true;
        }
        this.error = "Native bridge unavailable (open this page through the host).";
        return false;
    }

    handleReply(data) {
        if (!data || typeof data !== "object") return;
        if (data.ok !== true) {
            this.searching = false;
            this.loadingCapabilities = false;
            const failure = data.error;
            this.error = typeof failure === "string" ? failure : String((failure && failure.message) || "unknown error");
            this.status = "";
            return;
        }
        const value = data.data || {};
        if (Array.isArray(value.hits)) {
            const offset = Number(value.offset) || 0;
            const total = Number(value.total) || 0;
            this.searching = false;
            this.error = "";
            this.offset = offset;
            this.hasMore = value.hasMore === true;
            this.status = `Query complete in ${Number(value.tookMs) || 0} ms.`;
            this.modeText = `${value.mode || "index"} (indexed: ${value.indexed ? "yes" : "no"})`;
            this.totalText = String(total);
            const shown = offset + value.hits.length;
            this.pageText = `${offset}..${shown} of ${total}${value.hasMore ? " +" : ""}`;
            this.hitRows = value.hits.map((hit, index) => ({
                id: String(index),
                cells: [
                    String(hit.isDir ? "dir" : "file"),
                    this.formatBytes(Number(hit.size) || 0),
                    this.formatTime(Number(hit.modifiedMs) || 0),
                    String(hit.path || ""),
                    String(hit.frn ?? "—"),
                ],
            }));
            return;
        }
        if (Array.isArray(value.items)) {
            this.loadingCapabilities = false;
            this.error = "";
            this.status = "Capability report updated.";
            this.capabilityRows = value.items.map((item, index) => ({
                id: String(index),
                cells: [String(item.id || ""), String(item.state || "supported"), String(item.detail || "")],
            }));
        }
    }

    toggleCapabilities() {
        this.capabilitiesOpen = !this.capabilitiesOpen;
        if (this.capabilitiesOpen && !this.capabilityRows.length && !this.loadingCapabilities) this.loadCapabilities();
    }

    onPatternInput(event) {
        this.pattern = event && event.target ? String(event.target.value || "") : "";
    }

    onPathFilterInput(event) {
        this.pathFilter = event && event.target ? String(event.target.value || "") : "";
    }

    onKindChange(event) {
        this.kind = event && event.target ? String(event.target.value || "") : "";
    }

    onSortChange(event) {
        this.sort = event && event.target ? String(event.target.value || "") : "name";
    }

    query() {
        return {
            pattern: this.pattern || undefined,
            pathFilter: this.pathFilter || undefined,
            kind: this.kind || undefined,
            sort: this.sort,
            limit: this.pageSize,
            offset: this.offset,
        };
    }

    runSearch() {
        this.searching = true;
        this.error = "";
        if (!this.post({ type: "search", ...this.query() })) this.searching = false;
    }

    resetAndSearch() {
        this.offset = 0;
        this.runSearch();
    }

    nextPage() {
        if (!this.hasMore) return;
        this.offset += this.pageSize;
        this.runSearch();
    }

    previousPage() {
        if (this.offset === 0) return;
        this.offset = Math.max(0, this.offset - this.pageSize);
        this.runSearch();
    }

    runWalk() {
        this.searching = true;
        this.error = "";
        const root = (this.pathFilter || "").trim();
        if (!root) {
            this.searching = false;
            this.error = "Walk mode needs an absolute folder in the path filter field.";
            return;
        }
        if (!this.post({ type: "searchWalk", root, ...this.query() })) this.searching = false;
    }

    loadCapabilities() {
        this.loadingCapabilities = true;
        this.error = "";
        if (!this.post({ type: "capabilities" })) this.loadingCapabilities = false;
    }

    closeWindow() {
        this.post({ type: "close" });
    }

    formatBytes(value) {
        if (value < 1024) return `${value} B`;
        if (value < 1024 ** 2) return `${(value / 1024).toFixed(1)} KB`;
        if (value < 1024 ** 3) return `${(value / 1024 ** 2).toFixed(1)} MB`;
        return `${(value / 1024 ** 3).toFixed(2)} GB`;
    }

    formatTime(value) {
        if (!value) return "—";
        return new Date(value).toISOString().slice(0, 19).replace("T", " ");
    }
}
</script>
